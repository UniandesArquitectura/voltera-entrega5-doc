        <mxCell id="leg" value="Descartado: Bedrock AgentCore Gateway, servidor MCP administrado. Escribir los tres servidores es lo que demuestra el dominio del protocolo, que es lo que evalúa el tema. Entran después detrás del Gateway sin reescribirse." style="text;html=1;align=left;verticalAlign=top;fontSize=9;fontColor=#8795A3;" vertex="1" parent="1"><mxGeometry x="18" y="658" width="942" height="30" as="geometry"/></mxCell>
